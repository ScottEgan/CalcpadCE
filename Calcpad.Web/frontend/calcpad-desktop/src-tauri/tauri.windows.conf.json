{
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File build-frontend.ps1 -Watch",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File build-frontend.ps1"
  },
  "bundle": {
    "targets": ["msi", "nsis"],
    "resources": {
      "binaries/*.dll": "./",
      "binaries/Calcpad.Server.deps.json": "./",
      "binaries/Calcpad.Server.runtimeconfig.json": "./",
      "binaries/Calcpad.Server.staticwebassets.endpoints.json": "./",
      "binaries/appsettings.json": "./",
      "binaries/Calcpad.Server.exe": "./",
      "binaries/template.html": "./",
      "binaries/Fonts/*": "./Fonts/",
      "binaries/bg/*": "./bg/",
      "binaries/zh/*": "./zh/"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "version": "8.0.0.1"
      },
      "nsis": {
        "installMode": "perMachine"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "sign-windows.ps1",
          "%1"
        ]
      }
    }
  }
}
